[Unit]
Description=PostgreSQL backup (Node.js)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/postgresql-backup.env
# Optionnel : fichier YAML à la place des variables PG_INSTANCES
# Environment=CONFIG_FILE=/etc/postgresql-backup.yaml
WorkingDirectory=/opt/postgresql-backup
ExecStart=/usr/bin/node src/index.js run
StandardOutput=journal
StandardError=journal
SyslogIdentifier=postgresql-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/postgresql
