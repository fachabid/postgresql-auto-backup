PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me

BACKUP_DATABASES=myapp,myapp_test
BACKUP_DIR=/var/backups/postgresql
RETENTION_DAYS=30
# Nombre minimal de sauvegardes conservées par base, même si expirées
MIN_BACKUPS_KEPT=3
BACKUP_ROLES=false

# Version PostgreSQL (optionnel, auto-résolution binaires Ubuntu)
# PG_VERSION=14
# PG_DUMP=/usr/lib/postgresql/14/bin/pg_dump
# PG_DUMPALL=/usr/lib/postgresql/14/bin/pg_dumpall
# PSQL=/usr/lib/postgresql/14/bin/psql

# --- Mode multi-instance (alternative au mode legacy ci-dessus) ---
# PG_INSTANCES=pg14,pg16
#
# pg14_HOST=localhost
# pg14_PORT=5432
# pg14_USER=postgres
# pg14_PASSWORD=secret14
# pg14_DATABASES=ile_db,test_vector_db
# pg14_BACKUP_ROLES=false
# pg14_VERSION=14
#
# pg16_HOST=localhost
# pg16_PORT=5433
# pg16_USER=postgres
# pg16_PASSWORD=secret16
# pg16_DATABASES=app_new
# pg16_VERSION=16

# DRY_RUN=true
# LOG_FORMAT=text
# LOG_FILE=/var/log/postgresql-backup/backup.log
